#!/usr/bin/make -f

export GOCACHE := $(CURDIR)/build/go-cache

%:
	dh $@ --with bash-completion

override_dh_installsystemd-arch:
	dh_installsystemd -p anonimax --no-enable --no-start animaxd.service
	dh_installsystemd -p anonimax --no-enable --no-start anonimax-identity.service
	dh_installsystemd -p anonimax anonimax-recovery.service

override_dh_auto_build-arch:
	make build

override_dh_auto_test-arch:
	make check

override_dh_fixperms-arch:
	dh_fixperms
	chmod +x debian/anonimax/usr/lib/anonimax/anondaemon
	chmod +x debian/anonimax/usr/lib/anonimax/make-torrc
	chmod +x debian/anonimax/usr/lib/anonimax/safekill
	chmod 600 debian/anonimax/etc/anonimax/anonimax.cfg

override_dh_auto_build-indep override_dh_auto_test-indep:

override_dh_auto_install:
